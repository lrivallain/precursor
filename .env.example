# Precursor configuration. Every setting has a built-in default (see
# precursor/backend/config.py), so this file is optional — Precursor runs fine
# with no .env. Copy to `.env` and uncomment only what you want to override.

# --- Server ---
# `--port` (PRECURSOR_PORT) is always the URL you open. In `--dev` the Vite UI
# runs there and the backend moves to PORT + 1 (override with `--api-port`).
# A busy port auto-bumps to the next free one (use `--strict-port` to fail
# instead, or `--port 0` for any free port). Setting it here pins it instead:
# `precursor service install` then reports a clash rather than moving the app.
# PRECURSOR_HOST=127.0.0.1
# PRECURSOR_PORT=8000
# PRECURSOR_LOG_LEVEL=info
# Seconds to wait for in-flight requests (e.g. SSE streams) before force-closing
# on Ctrl-C, so the port is released promptly instead of hanging.
# PRECURSOR_SHUTDOWN_GRACE_SECONDS=3

# --- Database ---
# Defaults to a local SQLite file beside the code in a source checkout, and to
# the per-user data directory when installed as a wheel (macOS: ~/Library/
# Application Support/Precursor, Linux: ~/.local/share/precursor, Windows:
# %APPDATA%\Precursor) — a login item starts with cwd=/, so a relative default
# would create an empty database wherever it happened to launch.
# PRECURSOR_DATA_DIR=.precursor
# PRECURSOR_DATABASE_URL=sqlite+aiosqlite:///./precursor.db
# PRECURSOR_DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/precursor

# --- Background app (`precursor service …`, `precursor tray`) ---
# Where the update check looks, and which line it follows. An empty channel
# means "match the running build": a dev version follows `nightly` (the rolling
# build of main), a tagged one follows `stable`. Extras listed here are carried
# across a self-update so plugins aren't silently dropped; they are unioned with
# uv's install receipt, so prefix a name with `-` (e.g. `-kanban`) to give one
# up — useful when your package index can't serve it.
# PRECURSOR_UPDATE_REPO=lrivallain/precursor
# PRECURSOR_UPDATE_CHANNEL=
# PRECURSOR_UPDATE_EXTRAS=kanban
# PRECURSOR_UPDATE_CHECK_TTL_SECONDS=900

# --- GitHub ---
# Which `gh` login supplies the token (`gh auth token --user <login>`). Set it
# when several accounts are signed in, so the resolved token doesn't depend on
# whoever last ran `gh auth switch`. A token saved in Settings → GitHub wins.
# PRECURSOR_GITHUB_CLI_USER=

# --- Diagram editor ---
# `.drawio` files open in a self-hosted draw.io editor, downloaded on demand
# into <data dir>/drawio/<version>/ (~53 MB) rather than bundled in the wheel.
# Override the pinned release, or point the download at an internal mirror.
# PRECURSOR_DRAWIO_VERSION=v31.3.1
# PRECURSOR_DRAWIO_DOWNLOAD_URL=https://github.com/jgraph/drawio/releases/download/{version}/draw.war

# --- LLM provider ---
# The provider (GitHub Copilot, Azure AI Foundry, OpenAI, Mistral, Hugging
# Face, Ollama, or Mock) and its credentials are configured at runtime in the
# app — Settings → Model — not via the environment. The GitHub provider falls
# back to your `gh auth login` session when no token is saved.

# --- MCP tool servers ---
# Built-in MCP servers are toggled at runtime (Settings → MCP). Shortly after
# startup Precursor warms the enabled ones in the background, one at a time, so
# your first prompt doesn't pay connect + initialize + list_tools for all of
# them at once. It never blocks startup and never starts an interactive sign-in;
# set this to false to keep every connect lazy instead.
# PRECURSOR_MCP_WARMUP_ENABLED=true
#
# The hosted Agent 365 servers (`workiq-teams`, `workiq-user`) address your
# Microsoft tenant by GUID; set it here to seed the value, or leave it empty and let
# Precursor discover it from an existing WorkIQ sign-in.
# PRECURSOR_WORKIQ_TENANT_ID=00000000-0000-0000-0000-000000000000
# Keeping the WorkIQ / Agent 365 sign-ins alive. The keep-alive silently
# refreshes a token shortly before it expires, but backs off for credentials you
# aren't using: refreshing a server you never call is wasted work, and prompts
# you to sign in for tools you never asked for. `0` disables the back-off and
# keeps every signed-in credential warm indefinitely.
# PRECURSOR_WORKIQ_KEEPALIVE_ENABLED=true
# PRECURSOR_WORKIQ_KEEPALIVE_IDLE_AFTER_SECONDS=21600
# The remaining sign-in knobs (silent/auto/chained re-auth, loopback port
# fallback, poll and refresh margin) are documented in the configuration
# reference and rarely need changing.
#
# The WorkIQ sign-in trace (`precursor.mcp.auth`) has its own level, independent
# of PRECURSOR_LOG_LEVEL — a sign-in lapse only happens in the wild, so the
# trace is verbose by default and quiet outside an auth episode. Use `info` for
# transitions only, `warning` to silence it (GET /api/mcp/auth/diagnostics keeps
# the full in-memory trace either way).
# PRECURSOR_WORKIQ_AUTH_LOG_LEVEL=debug

# --- Backup ---
# Periodic copy of the SQLite DB + attachment blobs into a plain folder (e.g. a
# OneDrive/Dropbox/iCloud-synced directory). Enable it, pick the target folder
# and set snapshot retention at runtime in the app — Settings → Backup. Only the
# scheduling knobs below are env-level (the ticker polls every poll interval and
# runs once the interval has elapsed since the last success).
# PRECURSOR_BACKUP_INTERVAL_SECONDS=86400
# PRECURSOR_BACKUP_POLL_SECONDS=3600
