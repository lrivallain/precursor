{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "precursor-dev",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "exec uv run --frozen --no-sync precursor --dev --port \"${PORT:-8010}\" --strict-port --no-docs"
      ],
      "port": 8010,
      "autoPort": true
    },
    {
      "name": "precursor-demo",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "PYTHONPATH=\"$PWD\" DEMO_PORT=\"${PORT:-8899}\" exec ./scripts/demo_server.sh"
      ],
      "port": 8899,
      "autoPort": true
    },
    {
      "name": "precursor-demo-gh",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "DEMO_WITH_GH=1 PYTHONPATH=\"$PWD\" DEMO_PORT=\"${PORT:-8899}\" exec ./scripts/demo_server.sh"
      ],
      "port": 8899,
      "autoPort": true
    }
  ]
}
